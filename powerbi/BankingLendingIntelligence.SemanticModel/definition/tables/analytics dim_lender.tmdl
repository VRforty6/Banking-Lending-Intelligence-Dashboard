table 'analytics dim_lender'
	lineageTag: a6b6e20c-3f60-4a75-838f-0521d167db71

	column lei_key
		dataType: int64
		formatString: 0
		lineageTag: 09ed34a5-884d-45a7-8fa7-6ffacdc115b5
		summarizeBy: none
		sourceColumn: lei_key

		annotation SummarizationSetBy = Automatic

	column lei
		dataType: string
		lineageTag: f6ad7ddd-6873-4a73-a0fd-564c2c956491
		summarizeBy: none
		sourceColumn: lei

		annotation SummarizationSetBy = Automatic

	column lender_name
		dataType: string
		lineageTag: 2f0df559-18bd-4dc1-9f70-5fa37ff93bd8
		summarizeBy: none
		sourceColumn: lender_name

		annotation SummarizationSetBy = Automatic

	column 'Lender Display' =
			VAR CleanName = TRIM('analytics dim_lender'[lender_name])
			VAR CleanLei = TRIM('analytics dim_lender'[lei])
			VAR HasName = NOT ISBLANK(CleanName) && CleanName <> ""
			VAR DuplicateNameCount =
			    IF(
			        HasName,
			        COUNTROWS(
			            FILTER(
			                ALL('analytics dim_lender'),
			                TRIM('analytics dim_lender'[lender_name]) = CleanName
			            )
			        )
			    )
			RETURN
			    IF(
			        NOT HasName,
			        CleanLei,
			        IF(
			            DuplicateNameCount > 1,
			            CleanName & " (" & RIGHT(CleanLei, 6) & ")",
			            CleanName
			        )
			    )
		dataType: string
		lineageTag: 2b64d233-8c2e-405b-bd86-3770864b5d07
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'analytics dim_lender' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "banking_lending_intelligence"),
				    analytics_dim_lender = Source{[Schema="analytics",Item="dim_lender"]}[Data]
				in
				    analytics_dim_lender

	annotation PBI_ResultType = Table

