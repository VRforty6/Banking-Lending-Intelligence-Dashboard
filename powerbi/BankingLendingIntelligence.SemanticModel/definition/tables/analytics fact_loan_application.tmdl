		displayFolder: Executive Overview
		lineageTag: b46b0a9b-55aa-4d6b-b14a-5b0b9dfec62e

	measure 'Distinct Lenders' = DISTINCTCOUNT('analytics dim_lender'[lei])
		formatString: #,0
		displayFolder: Executive Overview
		lineageTag: 5b90c807-b108-4709-970e-4b021936c04d

	measure 'Distinct Counties' = DISTINCTCOUNT('analytics dim_geography'[county_code])
		formatString: #,0
		displayFolder: Executive Overview
		lineageTag: 06372094-83a2-41ce-973b-eaa5b5cc55e2

	partition 'analytics fact_loan_application' = m
		mode: import
		source =
				let
