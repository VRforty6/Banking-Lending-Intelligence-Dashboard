		formatString: #,0
		displayFolder: Executive Overview
		lineageTag: 5b90c807-b108-4709-970e-4b021936c04d

	measure 'Distinct Counties' = DISTINCTCOUNT('analytics dim_geography'[county_code])
		formatString: #,0
		displayFolder: Executive Overview
		lineageTag: 06372094-83a2-41ce-973b-eaa5b5cc55e2

	measure 'Application Volume YoY %' =
			VAR CurrentYear = MAX('analytics fact_loan_application'[application_year])
			VAR CurrentVolume =
			    CALCULATE(
			        [Application Volume],
			        REMOVEFILTERS('analytics fact_loan_application'[application_year]),
			        'analytics fact_loan_application'[application_year] = CurrentYear
			    )
			VAR PriorVolume =
			    CALCULATE(
			        [Application Volume],
			        REMOVEFILTERS('analytics fact_loan_application'[application_year]),
			        'analytics fact_loan_application'[application_year] = CurrentYear - 1
			    )
			RETURN
			    IF(
			        ISBLANK(CurrentYear) || ISBLANK(PriorVolume),
			        BLANK(),
			        DIVIDE(CurrentVolume - PriorVolume, PriorVolume)
			    )
		formatString: 0.0%
		displayFolder: Multi-Year Lending Trends
		lineageTag: 7d2e4a12-596b-4b6d-9bc5-f108d3c1bb76

	measure 'Origination Rate YoY Change' =
			VAR CurrentYear = MAX('analytics fact_loan_application'[application_year])
			VAR CurrentRate =
			    CALCULATE(
			        [Origination Rate],
			        REMOVEFILTERS('analytics fact_loan_application'[application_year]),
			        'analytics fact_loan_application'[application_year] = CurrentYear
			    )
			VAR PriorRate =
			    CALCULATE(
			        [Origination Rate],
			        REMOVEFILTERS('analytics fact_loan_application'[application_year]),
			        'analytics fact_loan_application'[application_year] = CurrentYear - 1
			    )
			RETURN
			    IF(
			        ISBLANK(CurrentYear) || ISBLANK(PriorRate),
			        BLANK(),
			        (CurrentRate - PriorRate) * 100
			    )
		formatString: +0.0 "pp";-0.0 "pp";0.0 "pp"
		displayFolder: Multi-Year Lending Trends
		lineageTag: 41c38e86-3ea8-423a-b45e-0aa889560759

	measure 'Denial Rate YoY Change' =
			VAR CurrentYear = MAX('analytics fact_loan_application'[application_year])
			VAR CurrentRate =
			    CALCULATE(
			        [Denial Rate],
			        REMOVEFILTERS('analytics fact_loan_application'[application_year]),
			        'analytics fact_loan_application'[application_year] = CurrentYear
			    )
			VAR PriorRate =
			    CALCULATE(
			        [Denial Rate],
			        REMOVEFILTERS('analytics fact_loan_application'[application_year]),
			        'analytics fact_loan_application'[application_year] = CurrentYear - 1
			    )
			RETURN
			    IF(
			        ISBLANK(CurrentYear) || ISBLANK(PriorRate),
			        BLANK(),
			        (CurrentRate - PriorRate) * 100
			    )
		formatString: +0.0 "pp";-0.0 "pp";0.0 "pp"
		displayFolder: Multi-Year Lending Trends
		lineageTag: 51c2e4da-f078-467c-a9f9-16c9a45cf745

	measure 'YoY Comparison Years' =
			VAR CurrentYear = MAX('analytics fact_loan_application'[application_year])
			VAR PriorYear = CurrentYear - 1
			VAR PriorRecords =
			    CALCULATE(
			        [Total HMDA Records],
			        REMOVEFILTERS('analytics fact_loan_application'[application_year]),
			        'analytics fact_loan_application'[application_year] = PriorYear
			    )
			RETURN
			    IF(
			        ISBLANK(CurrentYear) || ISBLANK(PriorRecords),
			        BLANK(),
			        FORMAT(CurrentYear, "0") & " vs " & FORMAT(PriorYear, "0")
			    )
		displayFolder: Multi-Year Lending Trends
		lineageTag: 95fd35c2-df13-487f-84a3-c0f52e0cd5a8

	measure 'Lender Ranking Application Volume' =
			CALCULATE(
			    [Application Volume],
			    ALLSELECTED('analytics dim_geography'[State Display]),
			    ALLSELECTED('analytics dim_loan'[Loan Purpose Label])
			)
		formatString: #,0
		displayFolder: Lender Performance
		lineageTag: dbd14c61-ecc6-42c9-8ea5-755a7ac94cb0

	measure 'Lender Application Volume Rank' =
			VAR CurrentLei = SELECTEDVALUE('analytics dim_lender'[lei])
			VAR SelectedLeis =
			    CALCULATETABLE(
			        VALUES('analytics dim_lender'[lei]),
			        ALLSELECTED('analytics dim_lender')
			    )
			VAR RankedLeis =
			    ADDCOLUMNS(
			        SelectedLeis,
			        "@ApplicationVolume",
			            VAR CandidateLei = 'analytics dim_lender'[lei]
			            RETURN
			                CALCULATE(
			                    [Lender Ranking Application Volume],
			                    REMOVEFILTERS('analytics dim_lender'),
			                    'analytics dim_lender'[lei] = CandidateLei
			                )
			    )
			VAR CurrentVolume =
			    MAXX(
			        FILTER(RankedLeis, 'analytics dim_lender'[lei] = CurrentLei),
			        [@ApplicationVolume]
			    )
			VAR HigherOrTieBefore =
			    COUNTROWS(
			        FILTER(
			            RankedLeis,
			            NOT ISBLANK([@ApplicationVolume]) &&
			            (
			                [@ApplicationVolume] > CurrentVolume ||
			                (
			                    [@ApplicationVolume] = CurrentVolume &&
			                    'analytics dim_lender'[lei] < CurrentLei
			                )
			            )
			        )
			    )
			RETURN
			    IF(
			        ISBLANK(CurrentLei) || ISBLANK(CurrentVolume),
			        BLANK(),
			        HigherOrTieBefore + 1
			    )
		formatString: 0
		displayFolder: Lender Performance
		lineageTag: 253f0817-62b0-4c72-9341-081f6e4b3ae5

	measure 'Is Top 15 Lender by Applications' = IF([Lender Application Volume Rank] <= 15, 1)
		formatString: 0
		displayFolder: Lender Performance
		lineageTag: 6ba13dc1-aab0-4ef5-ab56-9700a2b6c078

	measure 'Is Top 10 Lender by Applications' = IF([Lender Application Volume Rank] <= 10, 1)
		formatString: 0
		displayFolder: Lender Performance
		lineageTag: 438a8600-a83d-42d8-91cf-0bd3c4119e8b

	measure 'Application Volume Top 15 Lenders' =
			VAR InLenderScope =
			    ISINSCOPE('analytics dim_lender'[lei]) ||
			    ISINSCOPE('analytics dim_lender'[Lender Display])
			VAR TopLenders =
			    FILTER(
			        ALLSELECTED('analytics dim_lender'[lei]),
			        [Lender Application Volume Rank] <= 15
			    )
			RETURN
			    IF(
			        InLenderScope,
			        IF([Is Top 15 Lender by Applications] = 1, [Application Volume]),
			        CALCULATE([Application Volume], KEEPFILTERS(TopLenders))
			    )
		formatString: #,0
		displayFolder: Lender Performance
		lineageTag: b9fba33f-7e8a-4cc2-8db5-c82bfc2b2f8a

	measure 'Application Volume Top 10 Lenders' =
			VAR InLenderScope =
			    ISINSCOPE('analytics dim_lender'[lei]) ||
			    ISINSCOPE('analytics dim_lender'[Lender Display])
			VAR TopLenders =
			    FILTER(
			        ALLSELECTED('analytics dim_lender'[lei]),
			        [Lender Application Volume Rank] <= 10
			    )
			RETURN
			    IF(
			        InLenderScope,
			        IF([Is Top 10 Lender by Applications] = 1, [Application Volume]),
			        CALCULATE([Application Volume], KEEPFILTERS(TopLenders))
			    )
		formatString: #,0
		displayFolder: Lender Performance
		lineageTag: cfb70316-e6bd-4f00-b633-d1453df8ef49

	measure 'Origination Rate Top 15 Lenders' =
			VAR InLenderScope =
			    ISINSCOPE('analytics dim_lender'[lei]) ||
