	measure 'Application Volume' = COUNTROWS('analytics fact_loan_application')
		formatString: #,0
		displayFolder: Executive Overview
		lineageTag: 81ccf2ac-b177-46dd-a0f9-e8c0a08b143c

	measure 'Expected Fact Rows' = 12006526
		formatString: #,0
		displayFolder: Validation
		lineageTag: cfefad92-25c9-4e17-a9b2-435a0a41c845

	measure 'Fact Row Variance' = [Application Volume] - [Expected Fact Rows]
		formatString: #,0
		displayFolder: Validation
		lineageTag: 0f601f3b-d1f2-4a1d-a7a1-e2c776cddbb9

	measure 'Originated Applications' =

			CALCULATE(
			    [Application Volume],
			    'analytics dim_action_taken'[action_taken] = 1
			)
		formatString: #,0
		displayFolder: Executive Overview
		lineageTag: 171bbce0-e379-48f9-9f19-33f9e9fcb744

	measure 'Approved Not Accepted Applications' =

			CALCULATE(
			    [Application Volume],
			    'analytics dim_action_taken'[action_taken] = 2
			)
		formatString: #,0
		displayFolder: Approval & Denial Analysis
		lineageTag: b6fd1c73-b2ce-4264-91d8-8d51a78b38d3

	measure 'Denied Applications' =

			CALCULATE(
			    [Application Volume],
			    'analytics dim_action_taken'[action_taken] = 3
			)
		formatString: #,0
		displayFolder: Executive Overview
		lineageTag: c5a390f8-1024-44b8-909a-a6dfe9215d2a

	measure 'Withdrawn Applications' =

			CALCULATE(
			    [Application Volume],
			    'analytics dim_action_taken'[action_taken] = 4
			)
		formatString: #,0
		displayFolder: Executive Overview
		lineageTag: d20999e1-65d4-4462-aab0-218c1f9b46af

	measure 'Incomplete Applications' =

			CALCULATE(
			    [Application Volume],
			    'analytics dim_action_taken'[action_taken] = 5
			)
		formatString: #,0
		displayFolder: Executive Overview
		lineageTag: 197f449c-e6bd-4d78-a61e-061562f67a41

	measure 'Purchased Loans' =

			CALCULATE(
			    [Application Volume],
			    'analytics dim_action_taken'[action_taken] = 6
			)
		formatString: #,0
		displayFolder: Executive Overview
		lineageTag: 2b713c9d-47a6-4577-a8d8-945de5d08ab1

	measure 'Origination Rate' = DIVIDE([Originated Applications], [Application Volume])
		formatString: 0.0%
		displayFolder: Executive Overview
		lineageTag: a82448a7-4f7a-4614-ab14-a025a9533f5f

	measure 'Denial Rate' = DIVIDE([Denied Applications], [Application Volume])
		formatString: 0.0%
		displayFolder: Executive Overview
		lineageTag: 2079ec6d-c4dc-49a7-aa3c-46cb6ac6a85a

	measure 'Withdrawal Rate' = DIVIDE([Withdrawn Applications], [Application Volume])
		formatString: 0.0%
		displayFolder: Executive Overview
		lineageTag: 32fef576-8197-4bb2-8a50-5703955ca85d

	measure 'Incomplete Rate' = DIVIDE([Incomplete Applications], [Application Volume])
		formatString: 0.0%
		displayFolder: Executive Overview
		lineageTag: 054f3054-31e5-4364-9df9-2087c21e0349

	measure 'Total Loan Amount' = SUM('analytics fact_loan_application'[loan_amount])
		formatString: "$#,0;($#,0);$#,0"
		displayFolder: Executive Overview
		lineageTag: b6e96d4c-f224-42b4-a2f3-6cf0672be6d7

	measure 'Average Originated Loan Amount' =

			CALCULATE(
			    AVERAGE('analytics fact_loan_application'[loan_amount]),
			    'analytics dim_action_taken'[action_taken] = 1
			)
		formatString: "$#,0;($#,0);$#,0"
		displayFolder: Executive Overview
		lineageTag: 9d1e3f75-a30b-47f6-a7ab-ac9a15c188d4

	measure 'Average Applicant Income' = AVERAGE('analytics fact_loan_application'[income])
