	column 'Applicant Income Band' =
			SWITCH(
			    TRUE(),
			    ISBLANK('analytics fact_loan_application'[income]), "Income not reported",
			    'analytics fact_loan_application'[income] < 50, "Under $50K",
			    'analytics fact_loan_application'[income] < 100, "$50K-$99K",
			    'analytics fact_loan_application'[income] < 150, "$100K-$149K",
			    'analytics fact_loan_application'[income] < 250, "$150K-$249K",
			    "$250K+"
			)
		dataType: string
		lineageTag: 2ab96e78-a704-4ccb-8d34-4d7a3cadf977
		summarizeBy: none
		sortByColumn: 'Applicant Income Band Sort'

		annotation SummarizationSetBy = Automatic

	column 'Applicant Income Band Sort' =
			SWITCH(
			    TRUE(),
			    ISBLANK('analytics fact_loan_application'[income]), 99,
			    'analytics fact_loan_application'[income] < 50, 1,
			    'analytics fact_loan_application'[income] < 100, 2,
			    'analytics fact_loan_application'[income] < 150, 3,
			    'analytics fact_loan_application'[income] < 250, 4,
			    5
			)
		dataType: int64
		formatString: 0
		lineageTag: 38bb1d17-0cf9-4a52-a051-18cf5ffc162d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

