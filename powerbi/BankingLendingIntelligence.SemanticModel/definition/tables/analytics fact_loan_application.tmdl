		formatString: 0.0%
		displayFolder: Lender Performance
		lineageTag: 81bb88a8-963e-4b1f-b1b9-5624419406fc

	measure 'Denial Rate Top 15 Lenders' =
			VAR InLenderScope =
			    ISINSCOPE('analytics dim_lender'[lei]) ||
