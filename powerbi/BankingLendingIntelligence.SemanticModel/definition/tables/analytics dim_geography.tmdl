table 'analytics dim_geography'
	lineageTag: fc82d805-54f7-4b5c-bff1-e8b9d03a93ca

	column geography_key
		dataType: int64
		formatString: 0
		lineageTag: 48e223bb-76c8-4b35-8388-b1cb2ff4d55c
		summarizeBy: none
		sourceColumn: geography_key

		annotation SummarizationSetBy = Automatic

	column state_code
		dataType: string
		lineageTag: 413c5414-0d77-4b88-ba75-bd266567117e
		summarizeBy: none
		sourceColumn: state_code

		annotation SummarizationSetBy = Automatic

	column 'State Display' = ```
			SWITCH(
			    TRUE(),
			    ISBLANK('analytics dim_geography'[state_code]) || 'analytics dim_geography'[state_code] = "", "Unknown",
			    'analytics dim_geography'[state_code] = "CA", "California",
			    'analytics dim_geography'[state_code] = "TX", "Texas",
			    'analytics dim_geography'[state_code] = "FL", "Florida",
			    'analytics dim_geography'[state_code] = "NY", "New York",
			    'analytics dim_geography'[state_code] = "IL", "Illinois",
			    'analytics dim_geography'[state_code]
			)
			```
		dataType: string
		lineageTag: 6cf3fd19-f2e7-48df-bac6-1e96d2630817
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column county_code
		dataType: string
		lineageTag: 607480d2-2bad-4a3e-bdc8-ec9ad5a6f6bf
		summarizeBy: none
		sourceColumn: county_code

		annotation SummarizationSetBy = Automatic

	column 'County Name' = ```
			VAR StateCode = 'analytics dim_geography'[state_code]
			VAR CountyCode = 'analytics dim_geography'[county_code]
			VAR NormalizedCountyCode = UPPER(TRIM(CountyCode))
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(CountyCode) || NormalizedCountyCode = "" || NormalizedCountyCode = "UNKNOWN" || NormalizedCountyCode = "NA" || NormalizedCountyCode = "N/A" || NormalizedCountyCode = "NULL", "Unknown county",
			        ISBLANK(StateCode) || StateCode = "", "Unknown - " & CountyCode,
			        StateCode = "CA" || StateCode = "TX" || StateCode = "FL" || StateCode = "NY" || StateCode = "IL", StateCode & " - " & CountyCode,
			        "Unmapped county"
			    )
			```
		dataType: string
		lineageTag: edcd709b-49cc-4ba9-9d87-43f764e9359d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

